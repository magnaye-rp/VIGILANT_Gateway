[Unit]
Description=VIGILANT Transparent Proxy (mitmproxy)
After=network.target dnsmasq.service
Wants=dnsmasq.service

[Service]
Type=simple
User=vigilant-admin
WorkingDirectory=/home/vigilant-admin/vigilant_gateway
ExecStart=/home/vigilant-admin/vigilant_gateway/venv/bin/mitmdump \
  --mode transparent \
  --showhost \
  --listen-host 0.0.0.0 \
  --listen-port 8080 \
  --set block_global=false \
  --set ignore_hosts='^(.*\.)?(facebook|twitter|x|tiktok|instagram|reddit|youtube)\.com$' \
  -s /home/vigilant-admin/vigilant_gateway/src/vigilant_addon.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/vigilant-admin/vigilant_gateway/logs/proxy.log
StandardError=append:/home/vigilant-admin/vigilant_gateway/logs/proxy.log

[Install]
WantedBy=multi-user.target
